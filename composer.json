{
    "name": "fredbradley/socs-pupil-calendar",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.5.12",
        "johngrogg/ics-parser": "^3.6",
        "illuminate/support": "^12.0||^13.0",
        "spatie/icalendar-generator": "^3.3"
    },
    "autoload": {
        "psr-4": {
            "FredBradley\\SocsPupilCalendar\\": "src"
        }
    },
    "authors": [
        {
            "name": "Fred Bradley",
            "email": "frb@cranleigh.org"
        }
    ],
    "require-dev": {
        "laravel/pint": "^1.32",
        "pestphp/pest": "^5.3",
        "nunomaduro/collision": "^8.9"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
